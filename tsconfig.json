{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2024",
        "moduleResolution":"bundler",
        "strict": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "allowImportingTsExtensions": true,
        "lib": [
            "ES2024",
            "ESNext.Array",
            "ESNext.Collection",
            "ESNext.Error",
            "ESNext.Iterator",
            "ESNext.Promise",
            "DOM", 
            "DOM.Iterable" 
        ],
        "noEmit": true,
        "isolatedModules": true,
        "types": ["vite/client"],
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "Fragment"
    },
    "include": ["src/**/*", "types/**/*", "*.mts"]
}